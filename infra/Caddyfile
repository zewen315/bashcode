{$DOMAIN} {
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy frontend:3000
	}
}

# www resolves (Cloudflare-proxied) but had no site block here, so
# Caddy had no cert for that hostname — Cloudflare's TLS handshake to
# origin failed outright (its 525) for every request, ads.txt included.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
