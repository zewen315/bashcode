# Copy to .env on the droplet and fill in real values. Never commit .env
# itself (already gitignored).

# Domain Caddy requests a TLS cert for — must already point at this
# droplet's IP before `docker compose up` or the Let's Encrypt
# challenge will fail.
DOMAIN=bashcode.net

# Public URL the frontend embeds in its client-side JS bundle (baked in
# at build time). Requests are routed through Caddy to /api/*, which
# strips the prefix and forwards to the backend container.
NEXT_PUBLIC_API_URL=https://bashcode.net/api

# MUST be an absolute path that's identical on the host and matches
# exactly where bashcode-problems is actually cloned on the droplet —
# see the Docker-outside-of-Docker comment in docker-compose.yml for
# why (the judge's `docker run` calls are resolved by the HOST daemon,
# not this container's filesystem).
BASHCODE_PROBLEMS_PATH=/root/bashcode-problems

# Same requirement as above: absolute, identical host/container path.
# Just needs to exist (`mkdir -p /root/bashcode-scratch`) — the backend
# writes each submission's script here before handing it to the judge.
BASHCODE_SCRATCH_PATH=/root/bashcode-scratch

# Origins the backend's CORS policy allows, comma-separated. Must
# include the real public domain (with https://) or the browser blocks
# every client-side fetch from the deployed frontend.
CORS_ORIGINS=https://bashcode.net

# Self-hosted Postgres (see the `postgres` service in docker-compose.yml).
# These all default to "bashcode" in docker-compose.yml itself (via
# ${VAR:-bashcode}) so local dev works with no .env file at all — but
# POSTGRES_PASSWORD MUST be overridden to a real secret here for any
# real deployment. The default only exists for zero-config local dev.
POSTGRES_USER=bashcode
POSTGRES_PASSWORD=change-me-to-a-real-secret
POSTGRES_DB=bashcode

# OAuth login (GitHub + Google). The backend's single source of truth
# for computing each provider's redirect_uri, the post-login redirect
# target, and whether the session cookie gets the Secure flag
# (PUBLIC_BASE_URL.startswith("https://")) — deliberately not derived
# from the request's scheme, since behind Caddy the backend always sees
# plain HTTP regardless of the public-facing scheme.
# Prod: https://bashcode.net   Local dev: http://localhost:3000
PUBLIC_BASE_URL=https://bashcode.net
#
# GitHub: Settings > Developer settings > OAuth Apps > New OAuth App.
# Homepage URL: https://bashcode.net
# Authorization callback URL: https://bashcode.net/api/auth/github/callback
# GitHub only supports ONE callback URL per app — use a second OAuth
# App (with its own client id/secret) for local dev against
# http://localhost:3000/api/auth/github/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google: Cloud Console > APIs & Services > Credentials > Create
# Credentials > OAuth client ID > Web application.
# Authorized redirect URI: https://bashcode.net/api/auth/google/callback
# (Google allows multiple redirect URIs per client, unlike GitHub — you
# can add http://localhost:3000/api/auth/google/callback to the SAME
# client for local dev instead of creating a second one.)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (resend.com) — sends the /feedback form's email to
# support@bashcode.net. Use a "Sending access" key scoped to the
# bashcode.net domain specifically, not "Full access" — this key only
# ever needs to call the send endpoint, and it'll be sitting in a
# running container's environment.
RESEND_API_KEY=

# Twitter/X API keys for the @bashcode account — only used by
# web/backend/social_post.py, run manually via `docker compose exec
# backend python social_post.py <problem>`. Nothing else reads these;
# leave blank if you're not using that script.
# developer.twitter.com > your app > "Keys and tokens":
#   - API Key / API Key Secret: the app's own consumer keys.
#   - Access Token / Access Token Secret: generate these with Read and
#     Write permissions (the app defaults to Read-only) — media upload
#     and posting both need Write.
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Self-hosted Umami (stats.bashcode.net) — signs/hashes its own
# sessions and visitor identifiers, same role as a Django/Rails secret
# key. Generate with `openssl rand -hex 32`. Uses the SAME Postgres
# server as everything else, but its own `umami` database on it — see
# the `umami` service comment in docker-compose.yml for why that
# database has to be created by hand once, not by compose.
UMAMI_APP_SECRET=
